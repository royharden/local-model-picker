{
  "name": "local-model-picker",
  "version": "0.1.0",
  "description": "Measure installed Ollama models and quants on your own machine and pick one under your limits, with a trace and honest ties.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "lmp": "dist-cli/cli/index.js"
  },
  "exports": {
    "./runfile": {
      "types": "./dist-cli/src/core/runfile.d.ts",
      "default": "./dist-cli/src/core/runfile.js"
    },
    "./recommend": {
      "types": "./dist-cli/src/core/recommend/recommend.d.ts",
      "default": "./dist-cli/src/core/recommend/recommend.js"
    },
    "./evalkit": {
      "types": "./dist-cli/src/core/evalkit/index.d.ts",
      "default": "./dist-cli/src/core/evalkit/index.js"
    },
    "./providers": {
      "types": "./dist-cli/src/core/providers/index.d.ts",
      "default": "./dist-cli/src/core/providers/index.js"
    },
    "./hwprobe": {
      "types": "./dist-cli/cli/hwprobe/index.d.ts",
      "default": "./dist-cli/cli/hwprobe/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:cli": "tsc -p tsconfig.cli.json",
    "cli": "tsx cli/index.ts",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.app.json && tsc -p tsconfig.cli.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  }
}
